# =========================================================
# CodeBridge — root .gitignore (backend + frontend + project-wide)
# =========================================================

# --- Secrets / environment ---
.env
.env.*
!.env.example

# --- Python (backend/) ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Virtual environments
myenv/
venv/
env/
.venv/
ENV/

# Packaging / build artifacts
build/
dist/
*.egg

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checker / linter caches
.mypy_cache/
.ruff_cache/
.pyright/

# --- Node / frontend (if you add tooling later, e.g. npm, vite) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
dist/

# --- IDE / editor ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo

# --- OS-specific junk ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Logs ---
*.log
logs/

# --- Misc project artifacts ---
*.zip
*.tmp
.cache/